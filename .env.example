# --- Database (MySQL 8 or MariaDB 10.6+) ---
# For MySQL 8 on your own computer add ?allowPublicKeyRetrieval=true
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/flower_oms"

# --- Login sessions ---
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="change-me"
# The address people open in the browser. Use https:// in production.
NEXTAUTH_URL="http://localhost:3000"

# --- Optional ---
# Where uploaded photos are stored (default: ./uploads). Keep it OUTSIDE /public and back it up.
# UPLOAD_DIR="/var/lib/flower-oms/uploads"
# Shop time zone for "today" (default Asia/Baku)
# APP_TIMEZONE="Asia/Baku"
