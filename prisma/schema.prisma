// Prisma schema for Flower OMS.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client"
  output     = "../prisma-client"
  // Rust-free client: queries run through the MariaDB/MySQL driver adapter
  // (see src/lib/prisma.ts). No native query-engine binary is required.
  engineType = "client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CALL_CENTER
  FLORIST
}

enum OrderType {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  READY
  PICKUP
  OUT_FOR_DELIVERY
  COMPLETED
}

enum UnitType {
  STEM
  BUNCH
  BOX
}

enum PaymentMethod {
  CASH
  CARD
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdOrders  Order[]      @relation("OrderCreatedBy")
  assignedOrders Order[]      @relation("OrderAssignedTo")
  preparedOrders Order[]      @relation("OrderPreparedBy")
  orderEvents    OrderEvent[]
  stockEvents    StockEvent[]
  photosUploaded OrderPhoto[]
  payments       Payment[]
}

model Customer {
  id        String    @id @default(cuid())
  fullName  String
  phone     String    @unique
  email     String?
  address   String?
  birthday  DateTime?
  notes     String?   @db.Text
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  orders Order[]

  @@index([phone])
  @@index([fullName])
}

model Order {
  id               String      @id @default(cuid())
  orderNumber      Int         @unique @default(autoincrement())
  customerFullName String
  customerPhone    String
  deliveryDate     DateTime
  deliveryTime     String
  orderType        OrderType
  deliveryAddress  String?     @db.Text
  notes            String?     @db.Text
  amount           Decimal     @db.Decimal(12, 2)
  status           OrderStatus @default(NEW)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  createdById String
  createdBy   User   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("OrderAssignedTo", fields: [assignedToId], references: [id])

  preparedById String?
  preparedBy   User?   @relation("OrderPreparedBy", fields: [preparedById], references: [id])

  prepNotes String? @db.Text

  flowerUsages OrderFlowerUsage[]
  photos       OrderPhoto[]
  events       OrderEvent[]
  stockEvents  StockEvent[]
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, deliveryDate])
  @@index([assignedToId, status])
  @@index([preparedById, deliveryDate])
  @@index([customerId])
}

model Flower {
  id            String   @id @default(cuid())
  name          String   @unique
  unitType      UnitType
  stockQuantity Int      @default(0)
  lowStockLevel Int      @default(10)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  usages      OrderFlowerUsage[]
  stockEvents StockEvent[]
}

model OrderFlowerUsage {
  id        String   @id @default(cuid())
  orderId   String
  flowerId  String
  quantity  Int
  unitType  UnitType
  createdAt DateTime @default(now())

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  flower Flower @relation(fields: [flowerId], references: [id])

  @@unique([orderId, flowerId])
}

model StockEvent {
  id        String   @id @default(cuid())
  flowerId  String
  userId    String?
  orderId   String?
  delta     Int
  reason    String
  createdAt DateTime @default(now())

  flower Flower @relation(fields: [flowerId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([flowerId, createdAt])
  @@index([orderId, createdAt])
}

model OrderPhoto {
  id         String   @id @default(cuid())
  orderId    String
  uploaderId String
  fileName   String
  filePath   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  uploader User  @relation(fields: [uploaderId], references: [id])

  @@index([orderId, createdAt])
}

model OrderEvent {
  id        String       @id @default(cuid())
  orderId   String
  userId    String?
  type      String
  from      OrderStatus?
  to        OrderStatus?
  message   String?      @db.Text
  createdAt DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@index([orderId, createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  method      PaymentMethod
  amount      Decimal       @db.Decimal(12, 2)
  note        String?
  createdById String
  createdAt   DateTime      @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([orderId, createdAt])
  @@index([createdAt])
}
